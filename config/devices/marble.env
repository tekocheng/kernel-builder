# Poco F5 / Redmi Note 12 Turbo. Copy this file to add another device.
ARCH=arm64
DEVICE_NAME_1=marble
DEVICE_NAME_2=marblein
DEFCONFIG_SINGLE=marble_defconfig
GKI_FRAGMENTS="vendor/waipio_GKI.config vendor/xiaomi_GKI.config vendor/marble_GKI.config vendor/debugfs.config"
SUSFS_BRANCH=gki-android12-5.10
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
NOMOUNT_REPO=https://github.com/maxsteeel/nomount
NOMOUNT_REF=dev
ANYKERNEL_REPO=https://github.com/osm0sis/AnyKernel3.git
ANYKERNEL_REF=master
KBUILD_BUILD_USER=marble
KBUILD_BUILD_HOST=github-actions
