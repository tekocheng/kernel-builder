{
  "aospa": {
    "display": "AOSPA",
    "rom": "Paranoid Android calcite",
    "fetch": "manifest",
    "manifest_repo": "aospa-shadedark/kernel_manifest",
    "manifest_ref": "calcite-xiaomi-sm8450",
    "manifest_file": "default.xml",
    "kernel_path": "kernel_platform/xiaomi/sm8450",
    "manifest_skip": [
      "prebuilts/clang",
      "prebuilts-master",
      "gcc/linux-x86"
    ],
    "defconfig_mode": "gki_fragments",
    "toolchain": "android-r596125",
    "modules_src": "../sm8450-modules/qcom/opensource",
    "modules_list": "config/techpack-sm8450.txt",
    "notes": "Reads the manifest and clones its GitHub projects. AOSP clang and host gcc prebuilts are skipped; the selected toolchain is used instead."
  },
  "aosp": {
    "display": "AOSP",
    "rom": "aosp-pablo / LOS-based",
    "fetch": "git",
    "repo": "aosp-pablo/android_kernel_xiaomi_sm8450",
    "ref": "17",
    "defconfig_mode": "gki_fragments",
    "toolchain": "llvm-23.1.5",
    "modules_src": "../sm8450-modules/qcom/opensource",
    "modules_list": "config/techpack-sm8450.txt",
    "extra": [
      {
        "repo": "aosp-pablo/android_kernel_xiaomi_sm8450-modules",
        "ref": "17",
        "dest": "../sm8450-modules"
      },
      {
        "repo": "aosp-pablo/android_kernel_xiaomi_sm8450-devicetrees",
        "ref": "17",
        "dest": "../sm8450-devicetrees"
      }
    ]
  },
  "lineage": {
    "display": "LineageOS",
    "rom": "LineageOS official",
    "fetch": "git",
    "repo": "LineageOS/android_kernel_xiaomi_sm8450",
    "ref": "lineage-24.0",
    "defconfig_mode": "gki_fragments",
    "toolchain": "llvm-23.1.5",
    "modules_src": "../sm8450-modules/qcom/opensource",
    "modules_list": "config/techpack-sm8450.txt",
    "extra": [
      {
        "repo": "LineageOS/android_kernel_xiaomi_sm8450-modules",
        "ref": "lineage-24.0",
        "dest": "../sm8450-modules"
      },
      {
        "repo": "LineageOS/android_kernel_xiaomi_sm8450-devicetrees",
        "ref": "lineage-24.0",
        "dest": "../sm8450-devicetrees"
      }
    ]
  },
  "shinkai": {
    "display": "Shinkai",
    "rom": "AOSP / Shinkai Project",
    "fetch": "git",
    "repo": "nekoshirro/platform_kernel_xiaomi_marble",
    "ref": "17",
    "defconfig_mode": "gki_fragments",
    "config_fragments": [
      "vendor/waipio_GKI.config",
      "vendor/marble_GKI.config",
      "vendor/debugfs.config",
      "vendor/extra.config"
    ],
    "builtin_nomount": true,
    "uname_suffix": false,
    "toolchain": "llvm-23.1.5",
    "modules_src": "../sm8450-modules/qcom/opensource",
    "modules_list": "config/techpack-sm8450.txt",
    "extra": [
      {
        "repo": "nekoshirro/platform_kernel_xiaomi_marble-modules",
        "ref": "16",
        "dest": "../sm8450-modules"
      },
      {
        "repo": "nekoshirro/platform_kernel_xiaomi_marble-devicetrees",
        "ref": "16",
        "dest": "../sm8450-devicetrees"
      }
    ],
    "notes": "Kernel branch 17 (Android 17). The modules and devicetrees repos only publish branch 16; use source_ref=16 to build the kernel from branch 16 as well."
  },
  "lunaris": {
    "display": "Lunaris",
    "rom": "Lunaris AOSP",
    "fetch": "git",
    "repo": "dhanush281/android_kernel_xiaomi_sm8450",
    "ref": "lineage-23.2",
    "defconfig_mode": "gki_fragments",
    "toolchain": "llvm-23.1.5",
    "modules_src": "../sm8450-modules/qcom/opensource",
    "modules_list": "config/techpack-sm8450.txt",
    "extra": [
      {
        "repo": "dhanush281/android_kernel_xiaomi_sm8450-modules",
        "ref": "16.2",
        "dest": "../sm8450-modules"
      },
      {
        "repo": "dhanush281/android_kernel_xiaomi_sm8450-devicetrees",
        "ref": "16.2",
        "dest": "../sm8450-devicetrees"
      }
    ],
    "notes": "Kernel branch lineage-23.2 (Android 16 QPR2) with the matching 16.2 modules and devicetrees branches. The kernel branch lineage-24.0 is identical to the official LineageOS source."
  },
  "melt": {
    "display": "Melt",
    "rom": "HyperOS",
    "fetch": "git",
    "repo": "Pzqqt/android_kernel_xiaomi_marble",
    "ref": "melt-rebase",
    "defconfig_mode": "single",
    "defconfig": "marble_defconfig",
    "toolchain": "llvm-23.1.5",
    "notes": "Single-tree HyperOS kernel. Flash the Image on stock HyperOS only."
  },
  "bouquet": {
    "display": "Bouquet",
    "rom": "AOSP / LOS-based",
    "fetch": "git",
    "repo": "Pzqqt/android_kernel_xiaomi_marble",
    "ref": "bouquet_ci",
    "defconfig_mode": "single",
    "defconfig": "marble_defconfig",
    "toolchain": "llvm-23.1.5",
    "uname_suffix": false
  }
}
